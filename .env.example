# Public base URL used for canonical URLs, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.acailgas.pt

# Contact form delivery (server-side only — never prefix with NEXT_PUBLIC_).
# Without these three variables the form responds with "not configured" and nothing is sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
